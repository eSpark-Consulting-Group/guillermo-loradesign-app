{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "src/components/TableComponent"
  ]
}
